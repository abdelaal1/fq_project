<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>admin dashboard</title>
	<style type="text/css">

		.container {
		  display: none;
		  width: 50px;
		  transform: translateY(21px);
   		}
		  
   
		#Layer_1 {
		    width: 30px;
		    transform: scale(1.25);
		    stroke-dasharray: 30;
		    stroke-dashoffset: 30;
		    animation: check 0.5s;
		    -webkit-animation-fill-mode: forwards;
		    animation-fill-mode: forwards;
		}
		

		@keyframes check {
		  0% {
		    stroke-dashoffset: 30;
		  }
		  100% {
		    stroke-dashoffset: 0;
		  }
		}

		#outer{text-align: center; 
			width: 98%; 
			margin-left: auto;
			margin-right: auto; 
			max-width: 450px; 
			background-color: #e6ffb3;
			padding-top: 20px;
			padding-bottom: 20px;
			overflow: auto;
			position: relative;
		}

		input{
			width: 115px;
			height: 80px;
			border: 1px solid #0544b5;
			border-radius: 7px;
			font-size: 40px;
			padding-top: 0px;
			padding-bottom: 0px;
			text-align: center;
			anchor-name: --anchor;
		}

		.invalid{
			border: 1px solid red;
 			outline: 5px solid #ffb3b3;
		}

		.valid:focus{
			border: 1px solid #0544b5;
			outline: 5px solid #66ccff;		
		}

		input::-webkit-outer-spin-button,
		input::-webkit-inner-spin-button{
  			-webkit-appearance: none;
  			margin: 0;
			}

		input[type=number] {
		  -moz-appearance: textfield;
		}				

		#name{
			text-align: left;
			color: blueviolet;
			font-size: 16px;
			font-style: italic;
			margin-bottom: 20px;
			background-color: #9999ff;
			color: white;
			padding-top: 5px;
			padding-bottom: 5px;
			padding-left: 30px;
			padding-right: 30px;
			font-weight: bold;
		}

		#hint{
			margin-left: 10px;
			margin-right: 10px;
			text-align: left;
			font-size: 18px;
			font-style: italic;
			margin-top: 20px;
			margin-bottom: 0px;
		}

		#up{
			width: 50px;
			height: 50px;
			background-image: url('up.png'); 
			background-repeat: no-repeat; 
			background-position: center center;
			background-color: #b3d9ff;
			margin-bottom: 6px;
			border-radius: 25px;
			border: 2px solid #9999ff;
		}

		form{
			margin-top: 0px;
		}

		#down{
			width: 50px;
			height: 50px;
			background-image: url('down.png'); 
			background-repeat: no-repeat; 
			background-position: center center;
			background-color: #b3d9ff;
			margin-top: 6px;
			border-radius: 25px;
			border: 2px solid #9999ff;
		}

		#update{
			width: 70px;
			height: 40px;			
			background-color: #b3d9ff;
			border-radius: 8px;
			font-size: 16px;
			border: 2px solid #9999ff;
			display: inline-block;
			position: absolute;
			position-anchor: --anchor;
			left: calc(anchor(right) + 12px);
			top: calc(anchor(top) + 22px);

		}

		.disable{
			opacity: 0.5;
			width: 70px;
			height: 40px;			
			background-color: #b3d9ff;
			border-radius: 8px;
			font-size: 16px;
			border: 2px solid #9999ff;
			display: inline-block;
			position: absolute;
			position-anchor: --anchor;
			left: calc(anchor(right) + 12px);
			top: calc(anchor(top) + 22px);
		}

		.end{
			background-color: #e6ffb3;
			border: none;
			float: left;
			padding: 0px;
			width: 40px;
			height: 40px; 
			background-color: #4d4dff; 
			border-radius:8px;
			color: white;
			margin-left: 10px;
			font-weight: bold;			
		}

		.disable_end{
			opacity: 0.5;
			background-color: #e6ffb3;
			border: none;
			float: left;
			padding: 0px;
			width: 40px;
			height: 40px; 
			background-color: #9999ff; 
			border-radius:8px;
			color: white;
			margin-left: 10px;			
		}


		#logout{
			background-color: #e6ffb3; 
			border: none; 
			float: right; 
			margin-right: 10px;
			padding: 0px;
		}

		#edit{
			color: black;
			border: none;
			font-weight: bold;
			background-color: inherit;
			color:black;
			position: absolute;
			right: 30px;			
		}

		#edit:active{
			color: white;
		}

		#up:active{
			border: 2px solid #b3d9ff;
		}

		#down:active{
			border: 2px solid #b3d9ff;
		}

		.update:active{
			border: 2px solid #b3d9ff;
		}

		.end:active{
			opacity: 0.5;
		}

		#logout_img:active{
			opacity: 0.5;
		}

		#message{
			text-align: center;
			font-size: 20px;
			margin-top: 10px;
			margin-bottom: 20px;
			padding: 0px; 
		}

		#updating{
			padding: 0px;
			font-size: 20px; 
			color: #ff6600; 
			margin-bottom:10px;
			margin-top: 0px;
			text-align: center;
			width: 100px;
			display: none;
		}

		@keyframes appear {

		    0% {
		      font-size: 0px;
		    }

		    100% {
		     font-size: 20px;
		    }
		}

		#dialog, #dialog_edit, #invalid, #connection {
			width: 75%; 
			margin-left: auto;
			margin-right: auto; 
			max-width: 370px;
			border-radius: 10px;
			border-color: blue;
			box-shadow: 5px 5px 8px #b3b3ff;
		}

		#dialog > p{
			margin-top: 0px;
			margin-bottom: 16px;
		}

		#yes, #cancel, #ok_edit, #cancel_edit{
			float: right;
			padding: 6px;
			background-color: #0544b5;
			color:white; 
			border-radius:5px;
			border: 1px solid #0544b5;
		}

		#cancel, #cancel_edit{
			margin-right: 10px;
		}

		#close_invalid, #close_connection{
			padding: 6px;
			background-color: #0544b5;
			color:white; 
			border-radius:5px;
			border: 1px solid #0544b5;
		}

		#last_update{
			position: absolute;
			margin: 0px;
			position-anchor: --anchor;
			right: anchor(right);
			top: anchor(top);
			padding-right: 5px;
			padding-top: 3px;
			font-size: 14px;
			font-weight: bold;
			color: #990099;
		}

		@keyframes blink {

		    0% {
		      opacity: .2;
		    }

		    20% {
		      opacity: 1;
		    }

		    100% {
		      opacity: .2;
		    }
		}

		.updating span {

			font-size: 20px;

			font-weight: bold;

		    animation-name: blink;
		    
		    animation-duration: 1.4s;

		    animation-iteration-count: infinite;
		    
		    animation-fill-mode: both;
		}

		.updating span:nth-child(2) {
		    
		    animation-delay: .2s;
		}

		.updating span:nth-child(3) {
		    
		    animation-delay: .4s;
		}
		#help{
		position: fixed;
		position-anchor: --for_help;
		top: anchor(top);
		right: calc(anchor(right) + 75px);
		}

		@supports not (position-anchor: --anchor) {
			#update{
				transform: translate(50px,-45px);
			}
			#help{
				position: absolute;
				top: 220px;
				right: 20px;
			}
			#last_update{
				display: inline-block;
				width: 10%;
				padding-right: 0px;
				padding-top: 0px;
				font-size: 25px;
				bottom: 40px;
				left: 45%;
			}
		}

		@supports not (position-anchor: --anchor) {
			#update{
				transform: translate(50px,-45px);
			}
			#help{
				position: absolute;
				top: 220px;
				right: 20px;
			}
			#last_update{
				display: inline-block;
				width: 10%;
				padding-right: 0px;
				padding-top: 0px;
				font-size: 25px;
				bottom: 40px;
				left: 45%;
			}
		}						

	</style>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>
<body>
	<div id="outer">
		<p id="name" style="text-align: center;"><span id="service_provider">{{service_provider}}</span><button id="edit">Edit</button></p>
		<p id="hint"><span style="color: #9900cc;"><i class="fa fa-info-circle"></i> Enter last called customer number, then click </span><span style="font-style: normal; color: #9900cc; font-weight:bold;">Send</span>.<br><span style="color: red"><i class="fa fa-info-circle"></i> After serving last customer, click </span><span style="font-style: normal; color: orangered; font-weight:bold;">End</span>.<br><span style="color: green"><i class="fa fa-info-circle"></i> For customers link, click </span><a href="link-qr.html" style="color:green;">here</a></p>
		<div style="height: 30px; anchor-name: --for_help">
			<p class="updating" id="updating">Sending<span>.</span><span>.</span><span>.</span></p>
			<div id="check_mark" class="container">
				
				<svg id="Layer_1"><defs><style>.cls-2{fill:none;stroke: darkgreen;stroke-miterlimit:10;stroke-width:3px;}</style></defs>
  					<polyline class="cls-2" points="2.09 9.56 8.3 15.77 22.19 1.87"/></svg>
  			</div>
  		</div>			
		<button id="up"></button>			
		<form style="text-align: center;" novalidate>
			<input type="number" name="last_called_customer"  id="last_called_customer" class="valid" required min="1" max="99999" step="1" value="{{last_called_customer}}" autofocus>
		</form>
		<button id="down"></button>
		<button id="update" class="update">Send</button>
		<p id="message"></p>
		<div style="overflow: auto;">
			<button id="end" class="end">End</button>  
			<button id="logout" title="Logout" onclick="document.cookie = 'auth_jwt=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; httpOnly=true;'; location.href = 'index.html'"><img id="logout_img" src="/logout.png"></button>
		</div>
		<a href="admin_dashboard.html?lang=ar" style="position: absolute; top: 10px; right: 10px; text-decoration: none;">Ar</a>
		<a href="help.html" target="_blank"><img id="help" src="help.png"/></a>
		<span id="last_update"></span>
	</div>
	
	<dialog id="dialog">
		<p>Do you want to inform your customer that you have stopped providing the service?</p>
		<div>
			<button id="yes" value="yes">Yes</button>
			<button id="cancel" value="cancel">Cancel</button>
		</div>			
	</dialog>
	<dialog id="dialog_edit">
		<label for="new_name">New name</label>
		<div style="margin-bottom: 14px; margin-top: 2px;"><input type="text" name="new_name" id="new_name" maxlength="40" required style="width: 97%; height:25px; font-size: 14px; text-align: left; padding-left: 5px; border-radius: 2px;"></div>
		<div>
			<button id="ok_edit" value="yes">Ok</button>
			<button id="cancel_edit" value="cancel">Cancel</button>
		</div>			
	</dialog>
	<dialog id="invalid" style="text-align: center;">
		<p id="error_new_name" style="width: 98%; margin-left:auto; margin-right:auto; text-align: center;"></p>
		<button id="close_invalid">Ok</button>
	</dialog>

	<dialog id="connection" style="text-align: center;">
		<p id="connection_message" style="width: 98%; margin-left:auto; margin-right:auto; text-align: center;"></p>
		<button id="close_connection">Ok</button>
	</dialog>

	<script type="text/javascript">
		const last_called_customer = document.getElementById("last_called_customer");
		const edit = document.getElementById("edit");
		const name = document.getElementById("name");
		const service_provider = document.getElementById("service_provider");
		const update = document.getElementById("update");
		const up = document.getElementById("up");
		const down = document.getElementById("down");
		const message = document.getElementById("message");
		const end = document.getElementById("end");
		const dialog = document.getElementById("dialog");
		const yes = document.getElementById("yes");
		const cancel = document.getElementById("cancel");
		const updating = document.getElementById("updating");
		const new_name = document.getElementById("new_name");
		const ok_edit = document.getElementById("ok_edit");
		const cancel_edit = document.getElementById("cancel_edit");
		const dialog_edit = document.getElementById("dialog_edit");
		const close_invalid = document.getElementById("close_invalid");
		const invalid = document.getElementById("invalid");
		var get_new_name = "";
		const error_new_name = document.getElementById("error_new_name");		
		const logout = document.getElementById("logout");
		const check_mark = document.getElementById("check_mark");
		const last_update = document.getElementById("last_update");
		const connection = document.getElementById("connection");
		const connection_message = document.getElementById("connection_message");
		const close_connection = document.getElementById("close_connection");

		update.addEventListener("click", (event) => {
  			if (last_called_customer.validity.valueMissing) {
  				message.innerHTML = "&#9888; Please enter a number.";
  				message.style.color = "red";
  				last_called_customer.className = "invalid";
  				return;
  			}
  			if (last_called_customer.validity.rangeOverflow) {
  				message.innerHTML = "&#9888; Max. allowed number is 99999";
  				message.style.color = "red";
  				last_called_customer.className = "invalid";
  				return;
  			}
  			if (!(last_called_customer.validity.valid)) {
  				message.innerHTML = "&#9888; Please enter a valid customer number.";
  				message.style.color = "red";
  				last_called_customer.className = "invalid";
  				return;
  			}
  			if (navigator.onLine == true) {
	  			updating.style.display = "inline-block";
	  			update.className = "disable";
	  			document.body.style.pointerEvents = 'none';
	  			const xhttp = new XMLHttpRequest();
				xhttp.onreadystatechange = function() {
					if (this.readyState == 4 && this.status == 200) {
						const res_text=  xhttp.responseText;
						if (res_text == "done") {
							updating.style.display = "none";
							check_mark.style.display = "inline-block";
							setTimeout(hide_check_mark, 1000);
							function hide_check_mark(){
								check_mark.style.display = "none";
								last_update.innerText = last_called_customer.value;
							}
							update.className = "update";
	  						document.body.style.pointerEvents = 'auto';	
						}
					}
				};
					const url = "https://lit-lowlands-82854-b48a400450f7.herokuapp.com/update";
					xhttp.open("post", url, true);
					xhttp.setRequestHeader("Content-Type", "application/x-www-form-urlencoded");
					xhttp.send("last_called_customer="+ last_called_customer.value);
			}
			else{
				connection_message.innerHTML = "You are currently offline";
				connection.showModal();  
			}		

		});

		last_called_customer.addEventListener("input", (event) => {
  			if (last_called_customer.validity.valid) {
  				message.innerHTML = "";
  				last_called_customer.className = "valid";
  			}
		});

		up.addEventListener("click", (event) => {
			if(last_called_customer.value >= 99999){
				return;
			}
  			last_called_customer.value++;
  			if (last_called_customer.validity.valid) {
  				message.innerHTML = "";
  				last_called_customer.className = "valid";
  			}

		});

		down.addEventListener("click", (event) => {
			if(last_called_customer.value <= 1){
				return;
			}
  			last_called_customer.value--;
  			if (last_called_customer.validity.valid) {
  				message.innerHTML = "";
  				last_called_customer.className = "valid";
  			}
		});

		logout.addEventListener("click", (event) => {
			var xhttp = new XMLHttpRequest();
			var url = "logout";
			xhttp.open("get", url, false);
			xhttp.send();
		});

		end.addEventListener("click", (event) => {
			dialog.showModal();
		});

		yes.addEventListener("click", (event) => {
			dialog.close("yes");
			updating.style.display = "inline-block";
			end.className = "disable_end";
  			end.disabled =  true;
  			const xhttp = new XMLHttpRequest();
			xhttp.onreadystatechange = function() {
				if (this.readyState == 4 && this.status == 200) {
					const res_text=  xhttp.responseText;
					if (res_text == "done") {
						last_called_customer.value = "";
						last_update.innerText = "";
						updating.style.display = "none";
						check_mark.style.display = "inline-block";
						end.className = "end";
						end.disabled = false;
						setTimeout(hide_check_mark, 1000);
						function hide_check_mark(){
							check_mark.style.display = "none";
						}
					}
				}
			};
				const url = "https://lit-lowlands-82854-b48a400450f7.herokuapp.com/update";
				xhttp.open("post", url, true);
				xhttp.setRequestHeader("Content-Type", "application/x-www-form-urlencoded");
				xhttp.send("last_called_customer=0");

		});

		cancel.addEventListener("click", (event) => {
			dialog.close("cancel");
		});

		edit.addEventListener("click", (event) => {
			dialog_edit.showModal();
		});		

		ok_edit.addEventListener("click", (event) => {
			dialog_edit.close("ok");
		});

		cancel_edit.addEventListener("click", (event) => {
			dialog_edit.close("cancel");
		});

		dialog_edit.addEventListener("close", (event) => {
			if (dialog_edit.returnValue == "ok") {
				if (new_name.validity.valid) {
					get_new_name = new_name.value;
					const xhttp = new XMLHttpRequest();
					xhttp.onreadystatechange = function() {
					    if (this.readyState == 4 && this.status == 200) {
					    	res_text = xhttp.responseText;
							if (res_text.includes("Er")) {
								service_provider.innerText = "Error updating name. Please try again";
								service_provider.style.color = "red";
							}
							else{
								window.open("link-qr.html");
								service_provider.innerText = get_new_name;
								service_provider.style.color = "white";
							}
					    }					    
					};
					const url = "update_name?new_name="+ encodeURIComponent(get_new_name);
					xhttp.open("get", url, true);
					xhttp.send();	
				}
			
				else if(new_name.validity.valueMissing){
					error_new_name.innerText = "Please enter new name.";
					invalid.showModal();
				}

				else if(new_name.validity.tooLong){
					error_new_name.innerText = `Max. allowed character is ${new_name.maxLength}. You entered ${new_name.value.length} characters`;
					invalid.showModal();
				}
			}
											
		});

		close_invalid.addEventListener("click", (event) => {
			invalid.close();
			dialog_edit.showModal();
		});

		window.addEventListener('offline', function() {
			connection.close();
			connection_message.innerHTML = "You are currently offline";
			connection.showModal();    		
		});

		window.addEventListener('online', function() {
			connection.close();
			connection_message.innerHTML = "You are currently online";
			connection.showModal();    		
		});

		close_connection.addEventListener("click", (event) => {
			connection.close();
		});



	</script>

</body>
</html>