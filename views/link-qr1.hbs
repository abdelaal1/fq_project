<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Customer link & QR code</title>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
	<style type="text/css">
		div#outer{
		text-align: center;
		margin-left: auto;
		margin-right: auto;  
		width: 94%; 
		max-width: 450px; 
		background-color: #e6ffb3;
		padding-top: 20px;
		padding-bottom: 25px;
		padding-left: 10px;
		padding-right: 10px;
		position: relative;		
		}

		p{
			text-align: left;
			font-size: 18px;
		}

		button{
			height: 27px;
			background-color: #0544b5;
			border-radius: 7px;
			color: white;
			border: 1px solid #0544b5;
			font-size: 14px;
		}

		button:hover{
			color: #fff0b3;
		}

		button:active{
			opacity: 0.7;
		}


	</style>
</head>
<body>
<div id="outer">
	<p style="color: #00cc00; margin-bottom:0px; margin-top:0px; font-weight: bold; text-align: center;"><a href="admin_dashboard.html?lang=ar" style="float: left;text-decoration: none;">&#x2190;</a>{{service_provider}}</p>
	<p style="color: orangered; margin-bottom:8px; margin-top:10px; text-align:right;" dir="rtl">يمكن لعملائك متابعة الطابور من خلال الرابط التالى:</p>
	<p style="margin-bottom: 15px; color: #0544b5; margin-top: 0px; padding-left: 15px; overflow-x: hidden;"><a href="{{link}}" id="link" target="_blank">{{link}}</a></p>
	<div style="text-align: left; margin-bottom: 0px; margin-top: 0px;"><button style="margin-left: 15px;" onclick ="copy()" dir="rtl">نسخ الرابط <i class="fa fa-copy" aria-hidden="true"></i></button></div>
	<p style="margin-bottom: 10px; color: orangered; margin-top:12px; text-align:right;" dir="rtl">أو من خلال مسح الكود التالى</p>
	<div style="overflow: auto; margin-bottom: 15px"><img src="{{qr_code}}"></div>
	<div style="text-align: left;"><button style="margin-left: 15px; height:30px" onclick ="download_qr_code()" dir="rtl">تنزيل الكود <i class="fa fa-download" aria-hidden="true"></i></button></div>
	<a href="link-QR.html?lang=en" style="position: absolute; top: 10px; right: 10px; text-decoration: none;">En</a>
</div>
<script type="text/javascript">
	const link = document.getElementById("link");
	const link_str = link.href;
	function copy() {
	  navigator.clipboard.writeText(link_str);
	}

	function download_qr_code() {
		window.location.href = "https://lit-lowlands-82854-b48a400450f7.herokuapp.com/download_qr_code?link="+link_str;	    
	}
</script>
</body>
</html>